# Origen del sitio (solo esquema y dominio, sin ruta ni barra final).
# La ruta base /es/electrico-vs-gasolina la añade la aplicación.
# Producción: https://ododex.com
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identificador de editor de Google AdSense (ca-pub- y 16 dígitos).
# Vacío por defecto: sin AdSense ni botón "Configurar cookies".
NEXT_PUBLIC_ADSENSE_CLIENT=

# Unidad de anuncio de AdSense (10 dígitos).
# Vacío por defecto: no se muestra ningún hueco de anuncio.
NEXT_PUBLIC_ADSENSE_SLOT=

# Fichero de estaciones que lee el importador de precios de combustible.
# Por defecto, el que genera la web de gasolineras al compilar.
FUEL_STATIONS_FILE=../gasolineras/public/datos/estaciones.json
